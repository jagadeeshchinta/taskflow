# TaskFlow environment template.
# Copy to .env for local Docker demos. Use Jenkins/Kubernetes secrets for production.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001
API_URL=http://backend:3001
PORT=3001

# Database — Local Docker vs AWS RDS Configuration
# [Option 1: Local Docker Compose]
DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow
DIRECT_DATABASE_URL=postgresql://taskflow:taskflow@postgres:5432/taskflow
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# [Option 2: AWS RDS PostgreSQL]
# Set in EC2 production environment via AWS Secrets Manager dynamic injection:
# DATABASE_URL=postgresql://taskflowadmin:PASSWORD@taskflow-prod-postgres.xxxxxx.ap-south-1.rds.amazonaws.com:5432/taskflow?schema=public&sslmode=require
# DIRECT_DATABASE_URL=postgresql://taskflowadmin:PASSWORD@taskflow-prod-postgres.xxxxxx.ap-south-1.rds.amazonaws.com:5432/taskflow?schema=public&sslmode=require
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:<AWS_ACCOUNT_ID>:secret:taskflow/prod/rds-credentials
# RDS_ENDPOINT=taskflow-prod-postgres.xxxxxx.ap-south-1.rds.amazonaws.com
# RDS_PORT=5432
# DB_NAME=taskflow

# AWS S3 Storage Configuration
AWS_REGION=ap-south-1
S3_ATTACHMENTS_BUCKET=taskflow-attachments-<AWS_ACCOUNT_ID>-ap-south-1
MOCK_S3=false

# Redis
REDIS_URL=redis://redis:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=replace-with-openssl-rand-hex-32

# OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# DevOps platform
GRAFANA_ADMIN_PASSWORD=taskflow-admin
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true
NEXUS_REGISTRY=nexus:8082
METRICS_ENABLED=true
